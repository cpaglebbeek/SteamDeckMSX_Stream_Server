[Unit]
Description=SteamDeckMSX Sunshine streaming host
Documentation=https://github.com/cpaglebbeek/SteamDeckMSX_Stream_Server
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=msx
Group=msx

# CPU-budget vriendelijk voor shared HC55. P-SDM-04 + SHARED_INFRA_PATCH oorzaak/gevolg.
# 200% = max 2 cores; HC55 heeft 4 (cx32). Andere services krijgen voorrang via Nice.
CPUQuota=200%
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=4

# Memory cap (Sunshine + openMSX-headless + Xvfb).
MemoryHigh=1.5G
MemoryMax=2G

# Working dir + config.
WorkingDirectory=/opt/steamdeckmsx
# /run/sunshine voor Xvfb-pidfiles (xvfb-wrapper.sh) — msx-user kan /run niet zelf aanmaken.
RuntimeDirectory=sunshine
RuntimeDirectoryPreserve=yes
Environment="HOME=/var/lib/sunshine"
# /run/sunshine (RuntimeDirectory, msx-owned) — /run/user/<uid> bestaat niet voor system-user msx.
Environment="XDG_RUNTIME_DIR=/run/sunshine"
Environment="PATH=/opt/steamdeckmsx/bin:/usr/local/bin:/usr/bin:/bin"
# Sunshine test capture+encoder bij startup, dus display + audio moeten VÓÓR ExecStart
# bestaan — niet pas in apps.json prep-cmd (BUG v0.0.3: "Unable to find display or encoder").
Environment="DISPLAY=:0"
Environment="PULSE_RUNTIME_PATH=/run/sunshine/pulse"
# openMSX (SDL2) moet pulse pakken, niet ALSA — er is geen /dev/snd op de VPS.
Environment="SDL_AUDIODRIVER=pulseaudio"

# Sunshine zelf (verwacht /etc/sunshine/sunshine.conf + /etc/sunshine/apps.json).
ExecStartPre=/usr/bin/test -f /etc/sunshine/sunshine.conf
ExecStartPre=/usr/bin/test -f /etc/sunshine/apps.json
ExecStartPre=/opt/steamdeckmsx/bin/xvfb-wrapper.sh start :0 1280x800x24
ExecStartPre=-/usr/bin/pulseaudio --daemonize=yes --exit-idle-time=-1 --disallow-exit
ExecStart=/usr/bin/sunshine /etc/sunshine/sunshine.conf

# Restart-policy: bij crash 5s wachten, max 5 restarts in 60s — voorkomt loop bij config-fout.
Restart=on-failure
RestartSec=5s
StartLimitBurst=5
StartLimitIntervalSec=60s

# Logging via journal.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=steamdeckmsx-sunshine

# Security hardening.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sunshine /var/log/sunshine /var/lib/steamdeckmsx /run/sunshine
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
PrivateMounts=true

[Install]
WantedBy=multi-user.target
